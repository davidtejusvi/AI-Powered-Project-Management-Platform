{
  "name": "ai-pm-backend",
  "version": "1.0.0",
  "description": "AI-Powered Project Management Platform - Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
